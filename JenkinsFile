pipeline {
    agent any

    environment {
        NVM_DIR = "$HOME/.nvm"
        HOST = '47.129.44.226'  
        USERNAME = ilham
        KEY = credentials('ilhmlnaa')     
        PORT = '22'  
        PROJECT_DIR = '/home/ilham/projects/devops-exercise'
    }

    stages {
        stage('Check for changes and run tests') {
            steps {
                script {
                    // SSH ke server untuk cek perubahan dan jalankan tests
                    def beforePull = sh(script: """
                        ssh -i ${KEY} -p ${PORT} ${USERNAME}@${HOST} '
                            cd ${PROJECT_DIR}
                            git rev-parse HEAD
                        '
                    """, returnStdout: true).trim()

                    sh "ssh -i ${KEY} -p ${PORT} ${USERNAME}@${HOST} 'cd ${PROJECT_DIR} && git pull origin notesapp-consumer'"

                    def afterPull = sh(script: """
                        ssh -i ${KEY} -p ${PORT} ${USERNAME}@${HOST} '
                            cd ${PROJECT_DIR}
                            git rev-parse HEAD
                        '
                    """, returnStdout: true).trim()

                    if (beforePull == afterPull) {
                        echo "No new changes detected. Skipping tests."
                        currentBuild.result = 'SUCCESS'
                    } else {
                        echo "New changes detected. Running tests..."
                        // Jalankan linting dan test
                        sh "ssh -i ${KEY} -p ${PORT} ${USERNAME}@${HOST} 'cd ${PROJECT_DIR} && npm ci && npm run lint && npm run test'"
                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }

        stage('Deploy Application') {
            when {
                expression { currentBuild.result == 'SUCCESS' }
            }
            steps {
                script {
                    // Deploy aplikasi hanya jika ada perubahan dan tests berhasil
                    echo "Deploying application to AWS EC2..."
                    sh "ssh -i ${KEY} -p ${PORT} ${USERNAME}@${HOST} 'cd ${PROJECT_DIR} && pm2 restart notesapp-consumer'"
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished."
        }

        success {
            echo "Deployment successful!"
        }

        failure {
            echo "Deployment failed."
        }
    }
}
