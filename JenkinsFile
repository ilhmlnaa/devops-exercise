pipeline {
    agent any

    environment {
        HOST = '47.129.44.226'
        USERNAME = 'ilham'
        PORT = '22'
        PROJECT_DIR = '/home/ilham/projects/devops-exercise'
    }

    stages {
        stage('Check for changes and run tests') {
            steps {
                script {
                    withCredentials([sshUserPrivateKey(credentialsId: 'ilhmlnaa-tuf-key', keyFileVariable: 'KEY')]) {

                        // Tambahkan host ke known_hosts agar tidak gagal verifikasi
                        sh """
                            mkdir -p ~/.ssh
                            ssh-keyscan -p ${PORT} ${HOST} >> ~/.ssh/known_hosts
                        """

                        def beforePull = sh(script: '''
                            ssh -i $KEY -p 22 $USERNAME@$HOST '
                                cd $PROJECT_DIR
                                git rev-parse HEAD
                            '
                        ''', returnStdout: true).trim()

                        sh '''
                            ssh -i $KEY -p 22 $USERNAME@$HOST '
                                cd $PROJECT_DIR
                                git pull origin notesapp-consumer
                            '
                        '''

                        def afterPull = sh(script: '''
                            ssh -i $KEY -p 22 $USERNAME@$HOST '
                                cd $PROJECT_DIR
                                git rev-parse HEAD
                            '
                        ''', returnStdout: true).trim()

                        if (beforePull == afterPull) {
                            echo "No new changes detected! Skipping tests."
                            currentBuild.result = 'SUCCESS'
                        } else {
                            echo "New changes detected. Running tests..."
                            sh '''
                                ssh -i $KEY -p 22 $USERNAME@$HOST '
                                    cd $PROJECT_DIR
                                    source ~/.nvm/nvm.sh
                                    npm ci
                                    npm run lint
                                    npm run test
                                '
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy Application') {
            when {
                expression { currentBuild.result == null || currentBuild.result == 'SUCCESS' }
            }
            steps {
                script {
                    withCredentials([sshUserPrivateKey(credentialsId: 'ilhmlnaa-tuf-key', keyFileVariable: 'KEY')]) {
                        echo "Deploying application to AWS EC2..."
                        sh '''
                            ssh -i $KEY -p 22 $USERNAME@$HOST '
                                cd $PROJECT_DIR
                                pm2 restart notesapp-consumer
                            '
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished."
        }

        success {
            echo "Deployment successful!"
        }

        failure {
            echo "Deployment failed."
        }
    }
}
