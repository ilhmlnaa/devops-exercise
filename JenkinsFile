pipeline {
    agent any

    environment {
        HOST = '47.129.44.226'
        USERNAME = 'ilham'
        PORT = '22'
        PROJECT_DIR = '/home/ilham/projects/devops-exercise'
        BRANCH = 'notesapp-consumer'
        GIT_REPO = 'https://github.com/your-org/your-repo.git'  // Ganti dengan repo kamu
    }

    stages {
        stage('Check for changes and run tests') {
            steps {
                script {
                    withCredentials([sshUserPrivateKey(credentialsId: 'ilhmlnaa-tuf-key', keyFileVariable: 'KEY')]) {

                        // Tambah host ke known_hosts
                        sh """
                            mkdir -p ~/.ssh
                            ssh-keyscan -p ${PORT} ${HOST} >> ~/.ssh/known_hosts
                        """

                        // Ambil commit hash sebelum pull
                        def beforePull = sh(script: """
                            ssh -i \$KEY -p ${PORT} ${USERNAME}@${HOST} \\
                                'cd ${PROJECT_DIR} && git rev-parse HEAD'
                        """, returnStdout: true).trim()


                        // Git pull untuk ambil update dari branch
                        sh """
                            ssh -i \$KEY -p ${PORT} ${USERNAME}@${HOST} << 'EOF'
                                cd ${PROJECT_DIR} || exit 1
                                git pull origin ${BRANCH}
                            EOF
                        """

                        // Ambil commit hash sesudah pull
                        def afterPull = sh(script: """
                            ssh -i \$KEY -p ${PORT} ${USERNAME}@${HOST} << 'EOF'
                                cd ${PROJECT_DIR} || exit 1
                                git rev-parse HEAD
                            EOF
                        """, returnStdout: true).trim()

                        if (beforePull == afterPull) {
                            echo "✅ No new changes detected. Skipping tests."
                            currentBuild.result = 'SUCCESS'
                        } else {
                            echo "🔍 New changes detected. Running tests..."

                            // Jalankan npm install, lint, dan test
                            sh """
                                ssh -i \$KEY -p ${PORT} ${USERNAME}@${HOST} << 'EOF'
                                    cd ${PROJECT_DIR} || exit 1
                                    export NVM_DIR="\$HOME/.nvm"
                                    [ -s "\$NVM_DIR/nvm.sh" ] && \\. "\$NVM_DIR/nvm.sh"
                                    npm ci
                                    npm run lint
                                    npm run test
                                EOF
                            """
                        }
                    }
                }
            }
        }

        stage('Deploy Application') {
            when {
                expression { currentBuild.result == null || currentBuild.result == 'SUCCESS' }
            }
            steps {
                script {
                    withCredentials([sshUserPrivateKey(credentialsId: 'ilhmlnaa-tuf-key', keyFileVariable: 'KEY')]) {
                        echo "🚀 Deploying application..."

                        sh """
                            ssh -i \$KEY -p ${PORT} ${USERNAME}@${HOST} << 'EOF'
                                cd ${PROJECT_DIR} || exit 1
                                pm2 restart notesapp-consumer
                            EOF
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            echo "📦 Pipeline finished."
        }
        success {
            echo "✅ Deployment successful!"
        }
        failure {
            echo "❌ Deployment failed."
        }
    }
}
