# =======================================================
# DATABASE CONFIGURATION
# =======================================================

# Option 1: Gunakan DATABASE_URL (Recommended)
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/openmusicapp

# Option 2: Individual config (fallback jika DATABASE_URL tidak ada)
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=openmusicapp
PGHOST=localhost
PGPORT=5432

# =======================================================
# RABBITMQ CONFIGURATION
# =======================================================
RABBITMQ_SERVER=amqp://localhost

# =======================================================
# SMTP CONFIGURATION
# =======================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# =======================================================
# PRODUCTION EXAMPLES (commented out)
# =======================================================

# PostgreSQL di Heroku
# DATABASE_URL=postgres://user:pass@hostname:5432/dbname

# PostgreSQL di Railway
# DATABASE_URL=postgresql://postgres:pass@containers-us-west-1.railway.app:5432/railway

# PostgreSQL di Supabase
# DATABASE_URL=postgresql://postgres:pass@db.project.supabase.co:5432/postgres

# CloudAMQP (RabbitMQ)
# RABBITMQ_SERVER=amqps://user:pass@hawk.rmq.cloudamqp.com/vhost

# SendGrid SMTP
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
